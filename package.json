{
  "name": "freeink-windows-prototype",
  "productName": "FreeInk",
  "version": "0.2.5",
  "private": true,
  "description": "Offline-first multilingual handwriting app for Windows and macOS, with vector PDF and GitHub updates",
  "license": "MIT",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "dist:win": "node scripts/build-windows.cjs",
    "test": "node scripts/test.cjs",
    "release:win": "node scripts/build-windows.cjs",
    "dist:portable": "electron-builder --win portable --publish never",
    "dist:mac": "node scripts/build-macos.cjs",
    "build:standalone": "node scripts/build-standalone.cjs"
  },
  "dependencies": {
    "pdfjs-dist": "^5.3.93",
    "electron-updater": "^6.6.2",
    "mammoth": "^1.9.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.freeink.prototype",
    "productName": "FreeInk",
    "files": [
      "**/*",
      "!dist/**",
      "!.github/**",
      "!tests/**",
      "!scripts/**",
      "!*.md",
      "!*.bat",
      "!FreeInk-Standalone.html",
      "!node_modules/.cache/**",
      "!node_modules/@napi-rs/canvas/**",
      "!node_modules/@napi-rs/canvas-*/**"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/build/**/*",
      "node_modules/pdfjs-dist/wasm/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "artifactName": "FreeInk-${version}-${arch}.${ext}",
      "icon": "assets/app.ico"
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "msi": {
      "upgradeCode": "{2F05CC52-4794-5BA8-886B-0C615A724D1D}",
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "FreeInk-${version}-mac-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "freeink",
        "name": "FreeInk.Notebook",
        "description": "Editable FreeInk notebook",
        "mimeType": "application/x-freeink",
        "role": "Editor"
      }
    ]
  }
}
